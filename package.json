{
  "name": "mission-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "prisma generate && next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:start": "tsx scripts/local-db.ts start",
    "db:stop": "tsx scripts/local-db.ts stop",
    "db:status": "tsx scripts/local-db.ts status",
    "db:migrate": "tsx scripts/assert-local-db.ts && prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/assert-local-db.ts && prisma migrate reset --force && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create-owner": "tsx scripts/create-owner.ts",
    "e2e:prepare": "tsx scripts/e2e-prepare.ts",
    "brand:generate": "tsx scripts/generate-brand-assets.ts",
    "verses:build": "tsx scripts/build-daily-verses.ts",
    "vercel-build": "prisma migrate deploy && next build"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@vercel/blob": "2.8.2",
    "clsx": "2.1.1",
    "marked": "18.1.1",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.14.9",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "stripe": "23.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.1.2",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
