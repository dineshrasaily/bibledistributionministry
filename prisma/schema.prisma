generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------
enum AdminRole {
  OWNER
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum PostType {
  DEVOTIONAL
  ARTICLE
  MINISTRY_UPDATE
  BIBLE_STUDY
  TESTIMONY
}

enum EventKind {
  MISSION_TRIP
  OUTREACH
  SERVICE
  ANNOUNCEMENT
}

enum EventStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum BibleTranslation {
  WEB
  KJV
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO_EMBED
}

enum MediaCategory {
  SERMON
  WORSHIP
  PODCAST
  GALLERY
  GENERAL
}

enum StorageDriver {
  LOCAL
  VERCEL_BLOB
}

enum PrayerStatus {
  NEW
  PRAYED
  ARCHIVED
}

enum MessageKind {
  GENERAL
  TESTIMONY
  VOLUNTEER
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum ChallengePurpose {
  VERIFY
  ENROLL
}

enum FormKind {
  PRAYER
  CONTACT
  DONATION
}

enum DonationInterval {
  ONE_TIME
  MONTHLY
}

enum DonationStatus {
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum DonationSubscriptionStatus {
  ACTIVE
  CANCELED
}

enum PublicShareKind {
  PRAYER
  TESTIMONY
}

// ---------- settings ----------
model SiteSettings {
  id                     String           @id @default("singleton")
  ministryName           String
  taglineEn              String?
  taglineNe              String?
  missionStatementEn     String?
  missionStatementNe     String?
  visionEn               String? // Markdown
  visionNe               String?
  valuesEn               String? // Markdown
  valuesNe               String?
  statementOfFaithEn     String? // Markdown
  statementOfFaithNe     String?
  aboutIntroEn           String? // plain text, paragraphs separated by blank lines
  aboutIntroNe           String?
  testimonyEn            String? // Markdown, faith journey (About page)
  testimonyNe            String?
  goalsEn                String? // Markdown, goals and outreach (About page)
  goalsNe                String?
  aboutImageUrl          String? // https URL or site path; filled by the media picker (uploads live in MediaItem)
  aboutImageAltEn        String? // plain text; required when aboutImageUrl is set (Zod)
  aboutImageAltNe        String?
  logoUrl                String? // https URL or site path; filled by the media picker (uploads live in MediaItem)
  contactEmail           String
  socialLinks            Json             @default("[]") // SocialLink[] validated by Zod
  donationsEnabled       Boolean          @default(false)
  taxDeductibleVerified  Boolean          @default(false) // OWNER only; drives src/lib/donation-wording.ts
  isDemo                 Boolean          @default(true) // drives site-wide DemoBanner + hero/intro DemoBadge
  inboxRetentionMonths   Int              @default(12) // 1..60 (Zod), OWNER only; used by the manual purge
  givingInfoEn           String? // Markdown, "how gifts are used" (Support page); empty = demo text
  givingInfoNe           String?
  offlineGivingEnabled   Boolean          @default(false) // master switch: Zelle + bank section on the Support page
  zelleRecipientName     String? // exact name donors see in their bank app; required with email/phone/QR (Zod)
  zelleEmail             String?
  zellePhone             String?
  zelleQrUrl             String? // https URL or site path; filled by the media picker
  zelleQrAltEn           String? // plain text; defaulted by Zod when a QR is set
  zelleQrAltNe           String?
  bankName               String?
  bankAccountName        String? // account holder
  bankAccountNumber      String? // digits only; NEVER logged or put in audit metadata
  bankRoutingNumber      String? // ABA, 9 digits + checksum (Zod)
  bankSwiftCode          String? // BIC, 8 or 11 chars, upper-case
  bankAddress            String?
  bankShowAccountDetails Boolean          @default(false) // off: donors see "Contact us for bank transfer details"
  offlineGivingNoteEn    String? // plain text, e.g. memo instructions
  offlineGivingNoteNe    String?
  // Automatic verse of the day (src/lib/verse-of-the-day.ts). A BibleVerse
  // featured on today's date always wins over the automatic verse.
  autoVerseEnabled       Boolean          @default(true)
  autoVerseTranslation   BibleTranslation @default(WEB)
  siteTimezone           String           @default("America/New_York") // IANA zone (Zod); the day boundary for the verse of the day
  updatedAt              DateTime         @updatedAt
}

// ---------- admin auth ----------
model AdminUser {
  id               String    @id @default(cuid())
  email            String    @unique // stored lower-cased + trimmed
  name             String
  passwordHash     String // Argon2id PHC string
  totpSecretEnc    String? // "v1:<iv>:<tag>:<ct>" AES-256-GCM, AAD "totp:<id>"
  totpEnabled      Boolean   @default(false)
  lastTotpStep     Int? // replay protection (otplib afterTimeStep)
  role             AdminRole
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  sessionVersion   Int       @default(1) // bump to revoke all JWTs of this user
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  posts        Post[]
  auditLogs    AuditLog[]
  challenges   LoginChallenge[]
  publicShares PublicShare[]

  @@index([role, isActive])
}

model LoginChallenge {
  id               String           @id @default(cuid())
  tokenHash        String           @unique // sha256(base64url token); raw token only in cookie
  userId           String
  user             AdminUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose          ChallengePurpose
  pendingSecretEnc String? // ENROLL only; AAD "enroll:<userId>"
  attempts         Int              @default(0)
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String // sha256(AUTH_SECRET + ip), never the raw IP
  userId    String? // null for unknown emails
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String? // snapshot; "cli" for the bootstrap script
  action     String // e.g. "post.create", "settings.update", "auth.login.success"
  entityType String // "Post", "SiteSettings", "AdminUser", ...
  entityId   String?
  metadata   Json? // field names changed, status transitions; never secrets or message bodies
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ---------- content ----------
model Post {
  id               String         @id @default(cuid())
  type             PostType
  slug             String         @unique
  titleEn          String
  titleNe          String?
  excerptEn        String
  excerptNe        String?
  bodyEn           String         @default("") // Markdown
  bodyNe           String?
  scriptureRefs    String[]       @default([])
  coverImageUrl    String? // https URL or site path; filled by the media picker (uploads live in MediaItem)
  status           ContentStatus  @default(DRAFT)
  publishedAt      DateTime?
  isFeatured       Boolean        @default(false)
  isDemo           Boolean        @default(false)
  seoTitleEn       String?
  seoTitleNe       String?
  seoDescriptionEn String?
  seoDescriptionNe String?
  authorId         String?
  author           AdminUser?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories       PostCategory[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, type, publishedAt])
  @@index([status, isFeatured, publishedAt])
}

model Category {
  id        String         @id @default(cuid())
  slug      String         @unique
  nameEn    String
  nameNe    String?
  posts     PostCategory[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model BibleVerse {
  id          String           @id @default(cuid())
  reference   String // "Isaiah 6:8"
  text        String // English text of `translation` only (never a Nepali translation)
  translation BibleTranslation @default(WEB)
  featuredOn  DateTime?        @unique @db.Date // verse of the day (calendar date in SiteSettings.siteTimezone)
  status      ContentStatus    @default(PUBLISHED)
  isDemo      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, featuredOn])
}

model Event {
  id              String        @id @default(cuid())
  kind            EventKind
  slug            String        @unique
  titleEn         String
  titleNe         String?
  descriptionEn   String? // Markdown
  descriptionNe   String?
  reportEn        String? // Markdown post-trip report
  reportNe        String?
  startsAt        DateTime
  endsAt          DateTime?
  locationEn      String?
  locationNe      String?
  volunteerInfoEn String?
  volunteerInfoNe String?
  status          EventStatus   @default(UPCOMING) // lifecycle
  publishStatus   ContentStatus @default(DRAFT) // visibility
  coverImageUrl   String? // https URL or site path; filled by the media picker (uploads live in MediaItem)
  isDemo          Boolean       @default(false)
  galleries       Gallery[] // photo galleries linked to this event
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([publishStatus, status, startsAt])
}

model MediaItem {
  id               String         @id @default(cuid())
  type             MediaType
  category         MediaCategory  @default(GENERAL)
  titleEn          String
  titleNe          String?
  descriptionEn    String?
  descriptionNe    String?
  url              String? // IMAGE / AUDIO: https URL or site path; filled by the media picker (uploads live in MediaItem)
  embedUrl         String? // VIDEO_EMBED: normalized https://www.youtube-nocookie.com/embed/<id>
  altTextEn        String? // required for IMAGE (Zod)
  altTextNe        String?
  durationMinutes  Int?
  thumbnailUrl     String? // https URL or site path; filled by the media picker (uploads live in MediaItem)
  publishedAt      DateTime       @default(now())
  isFeatured       Boolean        @default(false)
  status           ContentStatus  @default(DRAFT)
  isDemo           Boolean        @default(false)
  galleryId        String? // one gallery per photo
  gallery          Gallery?       @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  sortOrder        Int            @default(0) // order inside its gallery
  // Uploaded files (null for pasted links)
  storageDriver    StorageDriver?
  storageKey       String?        @unique // local key or Vercel Blob pathname
  mimeType         String?
  sizeBytes        Int?
  width            Int?
  height           Int?
  originalFilename String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, isFeatured, publishedAt])
  @@index([status, category, publishedAt])
  @@index([galleryId, status, sortOrder])
}

/// An ordered photo gallery, optionally linked to a mission/event. Public
/// pages show a photo only when the gallery AND the photo are PUBLISHED.
model Gallery {
  id            String        @id @default(cuid())
  titleEn       String
  titleNe       String?
  descriptionEn String?
  descriptionNe String?
  eventId       String?
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  isDemo        Boolean       @default(false)
  items         MediaItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([eventId, status])
}

// ---------- inbox (Phase 6 writes, Phase 5 reads) ----------
model PrayerRequest {
  id           String       @id @default(cuid())
  name         String?
  email        String?
  isAnonymous  Boolean      @default(false)
  body         String
  shareConsent Boolean      @default(false)
  status       PrayerStatus @default(NEW)
  locale       String? // "en" | "ne", set by the Phase 6 form
  adminNote    String? // private, admin only
  publicShare  PublicShare?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id           String        @id @default(cuid())
  name         String
  email        String
  kind         MessageKind   @default(GENERAL)
  subject      String
  body         String
  shareConsent Boolean       @default(false)
  status       MessageStatus @default(NEW)
  locale       String?
  adminNote    String? // private, admin only
  publicShare  PublicShare?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

/// Admin-edited public version of a consented prayer request or testimony.
/// The only inbox-derived table public pages read (never the private rows).
model PublicShare {
  id               String          @id @default(cuid())
  kind             PublicShareKind
  textEn           String?
  textNe           String?
  prayerRequestId  String?         @unique
  prayerRequest    PrayerRequest?  @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  contactMessageId String?         @unique
  contactMessage   ContactMessage? @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  publishedById    String?
  publishedBy      AdminUser?      @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt      DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([publishedAt])
}

// ---------- donations (Phase 8, written only by the Stripe webhook) ----------

/// One received gift. Deliberately NO card data of any kind (no brand, last4,
/// expiry or billing address): Stripe keeps those; we keep reference ids.
model Donation {
  id                      String                @id @default(cuid())
  amountCents             Int
  currency                String                @default("usd")
  interval                DonationInterval
  status                  DonationStatus        @default(PAID)
  amountRefundedCents     Int                   @default(0)
  donorEmail              String? // lower-cased, max 254; from Stripe checkout/invoice
  livemode                Boolean               @default(false)
  stripeCheckoutSessionId String?               @unique
  stripeInvoiceId         String?               @unique
  stripePaymentIntentId   String?               @unique
  stripeCustomerId        String?
  subscriptionId          String?
  subscription            DonationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paidAt                  DateTime
  refundedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([paidAt])
  @@index([status, paidAt])
  @@index([interval, paidAt])
}

/// A monthly gift (Stripe subscription). Each month's payment is a Donation.
model DonationSubscription {
  id                   String                     @id @default(cuid())
  stripeSubscriptionId String                     @unique
  stripeCustomerId     String?
  amountCents          Int
  currency             String                     @default("usd")
  status               DonationSubscriptionStatus @default(ACTIVE)
  donorEmail           String?
  livemode             Boolean
  startedAt            DateTime
  canceledAt           DateTime?
  donations            Donation[]
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([status])
}

/// Idempotency ledger: one row per processed Stripe event id (evt_...).
model StripeEvent {
  id          String   @id
  type        String
  livemode    Boolean
  outcome     String // "processed" | "ignored"
  processedAt DateTime @default(now())

  @@index([processedAt])
}

/// Public form rate limit (per form, per hashed IP; never the raw IP).
model FormSubmissionAttempt {
  id        String   @id @default(cuid())
  form      FormKind
  ipHash    String // sha256(AUTH_SECRET + ip)
  createdAt DateTime @default(now())

  @@index([form, ipHash, createdAt])
  @@index([createdAt])
}
