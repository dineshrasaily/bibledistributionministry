# Copy this file to `.env` (not .env.local: Prisma and the scripts only read .env).
# Never put Neon/production URLs in your local .env. See README > Going live.
# Never commit real values. In Vercel, set the same names under
# Project > Settings > Environment Variables, then redeploy.
#
# Each entry says: what it is, where to get it, and which Vercel
# environments need it (Production / Preview).

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------
# Public base URL of the site. Used for metadataBase, canonical and hreflang
# URLs, the sitemap and robots.txt. Safe to expose to the browser.
# Vercel: Production = https://your-domain (an https URL also switches on the
# CSP upgrade-insecure-requests); Preview = the preview URL or leave unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Database connection. Locally: the dev DB started with `npm run db:start`.
# Vercel (Production + Preview): Neon > Connection details > the POOLED URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/mission_dev"
# Neon only (set in Vercel, not here): the DIRECT (non-pooled) URL used by
# Prisma migrations. Leave empty locally. Vercel: Production + Preview.
DIRECT_URL=
# Auth.js session encryption. Required everywhere.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Vercel: Production + Preview (use a different value for each).
AUTH_SECRET=
# 32-byte base64 key encrypting authenticator secrets. Same command as above.
# Required. NEVER change it once set: changing it invalidates every 2FA setup.
# Vercel: Production (keep a copy in a password manager); Preview: its own value.
TOTP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Prayer and contact forms (all optional; see README > Going live, steps 7-8)
# ---------------------------------------------------------------------------
# Cloudflare Turnstile spam check (Cloudflare dashboard > Turnstile > your
# widget). Leave both empty to use Cloudflare's always-pass test keys (fine
# locally; no bot protection in production). Vercel: Production (+ Preview if
# the preview domain is added to the widget).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Resend email notices (link only, never the message text). Resend > API Keys.
# Empty = the notice is only written to the server log. Vercel: Production.
# RESEND_API_KEY=
# Sender address on a domain verified in Resend (e.g. notices@your-domain).
# Vercel: Production.
# RESEND_FROM_EMAIL=
# Who receives the notices. Defaults to the contact email in admin Settings.
# Optional. Vercel: Production.
# CONTACT_TO_EMAIL=
# Accepted submissions per form per network per hour (default 5). Optional.
# FORM_RATE_LIMIT_PER_HOUR=

# ---------------------------------------------------------------------------
# Media uploads (optional; see README > Going live, step 6)
# ---------------------------------------------------------------------------
# Vercel Blob read-write token (public store). Vercel > Storage > Blob >
# connect to the project (Vercel adds it for you). Empty locally means
# uploaded files go to .local/uploads (never committed). On Vercel, empty
# means uploads are switched off and pasted links still work.
# Vercel: Production + Preview.
# BLOB_READ_WRITE_TOKEN=
# Dev only: folder for locally stored uploads (default .local/uploads).
# Never set it in Vercel.
# LOCAL_UPLOAD_DIR=

# ---------------------------------------------------------------------------
# Donations (optional; see README > Going live, step 9)
# ---------------------------------------------------------------------------
# Stripe secret key (sk_test_... locally and in Preview, sk_live_... only in
# Vercel Production when you go live). Stripe > Developers > API keys.
# Server only. No publishable key is needed: card entry happens on Stripe.
# Online giving opens only when BOTH this key and the webhook signing secret
# below are set (and "donations enabled" is ticked in admin Settings).
# STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) from Stripe > Developers > Webhooks >
# your endpoint, or printed by `stripe listen` when testing locally. Test
# and live endpoints each have their OWN secret. Vercel: Production (+ Preview
# with the test-mode endpoint's secret).
# STRIPE_WEBHOOK_SECRET=
# Optional Stripe customer portal login link (https://billing.stripe.com/p/login/...)
# so monthly donors can change or cancel their gift. Vercel: Production.
# STRIPE_CUSTOMER_PORTAL_URL=
# Checkout attempts per network per hour (default 10). Optional.
# DONATION_RATE_LIMIT_PER_HOUR=
# Automated tests only (loopback address + test key only). Never set it in Vercel.
# STRIPE_API_BASE_URL_FOR_TESTS=

# ---------------------------------------------------------------------------
# Set automatically / scripts only (do NOT put these in .env or Vercel)
# ---------------------------------------------------------------------------
# OWNER_PASSWORD: only in a one-off PowerShell window for
#   `npm run admin:create-owner` (see README). Never in .env or Vercel.
# VERCEL: set by Vercel on its servers ("1"). Never set it yourself.
# NODE_ENV: set by Next.js. Never set it yourself.
# Do not set AUTH_URL: trustHost is on and Vercel provides the host.
