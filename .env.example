# Copy this file to `.env` (not .env.local: Prisma and the scripts only read .env).
# Never put Neon/production URLs in your local .env. See README > Switching to Neon.
# Never commit real values.

# Public base URL of the site. Used for metadataBase, canonical and hreflang
# URLs, the sitemap and robots.txt. Safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local dev DB (started with `npm run db:start`).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/mission_dev"
# Neon only (set in Vercel, not here): non-pooled URL used by Prisma migrations. Leave empty locally.
DIRECT_URL=

# Auth.js session encryption. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# 32-byte base64 key encrypting authenticator secrets. Same command as above. Changing it invalidates all 2FA setups.
TOTP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Prayer and contact forms (all optional; see README > Setting up Turnstile / Resend)
# ---------------------------------------------------------------------------
# Cloudflare Turnstile spam check. Leave both empty to use Cloudflare's
# always-pass test keys (fine locally; no bot protection in production).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Resend email notices (link only, never the message text). Empty = the
# notice is only written to the server log.
# RESEND_API_KEY=
# Sender address on a domain verified in Resend.
# RESEND_FROM_EMAIL=
# Who receives the notices. Defaults to the contact email in admin Settings.
# CONTACT_TO_EMAIL=
# Accepted submissions per form per network per hour (default 5).
# FORM_RATE_LIMIT_PER_HOUR=

# ---------------------------------------------------------------------------
# Media uploads (optional; see README > Setting up Vercel Blob)
# ---------------------------------------------------------------------------
# Vercel Blob read-write token (public store). Empty locally means uploaded
# files go to .local/uploads (never committed). On Vercel, empty means uploads
# are switched off and pasted links still work.
# BLOB_READ_WRITE_TOKEN=
# Dev only: folder for locally stored uploads (default .local/uploads).
# LOCAL_UPLOAD_DIR=

# ---------------------------------------------------------------------------
# Donations (optional; see README > Setting up Stripe)
# ---------------------------------------------------------------------------
# Stripe secret key (sk_test_... locally, sk_live_... only in Vercel when you
# go live). Server only. Empty = the Support page says "online giving is not
# set up yet". No publishable key is needed: card entry happens on Stripe.
# STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...) from Stripe > Developers > Webhooks, or
# printed by `stripe listen` when testing locally.
# STRIPE_WEBHOOK_SECRET=
# Optional Stripe customer portal login link (https://billing.stripe.com/p/login/...)
# so monthly donors can change or cancel their gift.
# STRIPE_CUSTOMER_PORTAL_URL=
# Checkout attempts per network per hour (default 10).
# DONATION_RATE_LIMIT_PER_HOUR=
# Automated tests only (loopback address + test key only). Never set it in Vercel.
# STRIPE_API_BASE_URL_FOR_TESTS=
